---
import Footer from '../../components/Footer.astro';
import Navigation from '../../components/Navigation.astro';
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="AI Image Studio - WEBACELA"
  description="Create images from text or transform an existing image with WEBACELA AI Image Studio."
>
  <Navigation />

  <main class="min-h-screen bg-[#f5f7fb] text-slate-950">
    <section class="relative overflow-hidden border-b border-slate-200 bg-slate-950 px-4 py-16 text-white sm:py-20">
      <div class="absolute inset-0 opacity-50" aria-hidden="true">
        <div class="absolute -left-24 -top-24 h-80 w-80 rounded-full bg-violet-600/40 blur-3xl"></div>
        <div class="absolute -bottom-32 right-0 h-96 w-96 rounded-full bg-cyan-500/30 blur-3xl"></div>
      </div>
      <div class="relative mx-auto max-w-6xl">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-4 py-2 text-sm text-violet-100 backdrop-blur">
          <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
          Powered by OmniRouter
        </div>
        <h1 class="max-w-4xl text-4xl font-bold tracking-tight sm:text-6xl">
          Create it. Change it. Make it yours.
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-300 sm:text-xl">
          Turn a written idea into an image, or upload a visual and describe exactly how you want it transformed.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-10 sm:py-14">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
        <form id="image-tool-form" class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7">
          <fieldset>
            <legend class="text-sm font-semibold text-slate-700">Start with</legend>
            <div class="mt-3 grid grid-cols-2 rounded-2xl bg-slate-100 p-1">
              <button type="button" class="mode-button rounded-xl px-4 py-3 text-sm font-semibold transition" data-mode="generate" aria-pressed="true">
                Text prompt
              </button>
              <button type="button" class="mode-button rounded-xl px-4 py-3 text-sm font-semibold transition" data-mode="edit" aria-pressed="false">
                An image
              </button>
            </div>
          </fieldset>

          <input type="hidden" id="mode" name="mode" value="generate" />

          <div id="upload-section" class="mt-6 hidden">
            <label class="mb-2 block text-sm font-semibold text-slate-700" for="source-image">Source image</label>
            <label id="drop-zone" for="source-image" class="group flex min-h-52 cursor-pointer flex-col items-center justify-center overflow-hidden rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50 p-5 text-center transition hover:border-violet-400 hover:bg-violet-50/50">
              <div id="upload-empty">
                <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-white text-violet-600 shadow-sm">
                  <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 16V4m0 0L7 9m5-5 5 5"/><path d="M4 15v4a1 1 0 001 1h14a1 1 0 001-1v-4"/></svg>
                </span>
                <span class="mt-4 block font-semibold text-slate-800">Drop an image here or click to browse</span>
                <span class="mt-1 block text-sm text-slate-500">PNG, JPEG or WebP · source up to 30 MB · large files are optimized</span>
              </div>
              <img id="source-preview" class="hidden max-h-72 w-full rounded-xl object-contain" alt="Selected source preview" />
            </label>
            <div id="file-row" class="mt-3 hidden items-center justify-between gap-3 rounded-xl bg-slate-50 px-3 py-2 text-sm">
              <span id="file-name" class="min-w-0 truncate text-slate-600"></span>
              <button id="remove-image" type="button" class="font-semibold text-rose-600 hover:text-rose-700">Remove</button>
            </div>
            <input id="source-image" name="image" class="sr-only" type="file" accept="image/png,image/jpeg,image/webp" />
          </div>

          <div class="mt-6">
            <div class="flex items-center justify-between gap-3">
              <label class="text-sm font-semibold text-slate-700" for="prompt">Instructions</label>
              <span id="prompt-count" class="text-xs text-slate-400">0 / 4000</span>
            </div>
            <textarea id="prompt" name="prompt" required maxlength="4000" rows="6" class="mt-2 w-full resize-y rounded-2xl border border-slate-300 bg-white px-4 py-3 text-base text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-violet-500 focus:ring-4 focus:ring-violet-100" placeholder="A cinematic product photo of a translucent glass sneaker on a reflective surface, soft violet lighting..."></textarea>
            <div class="mt-3 flex flex-wrap gap-2" aria-label="Prompt ideas">
              <button type="button" class="prompt-chip">Photorealistic</button>
              <button type="button" class="prompt-chip">Editorial</button>
              <button type="button" class="prompt-chip">3D render</button>
              <button type="button" class="prompt-chip">Watercolor</button>
            </div>
          </div>

          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            <label class="text-sm font-semibold text-slate-700">
              Model
              <select id="model" name="model" class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-3 text-sm font-medium outline-none focus:border-violet-500 focus:ring-4 focus:ring-violet-100"></select>
            </label>
            <label class="text-sm font-semibold text-slate-700">
              Canvas
              <select id="size" name="size" class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-3 text-sm font-medium outline-none focus:border-violet-500 focus:ring-4 focus:ring-violet-100"></select>
            </label>
          </div>

          <div id="direct-api-key-section" class="mt-5 hidden rounded-2xl border border-amber-200 bg-amber-50 p-4">
            <label class="text-sm font-semibold text-amber-950" for="direct-api-key">Testing API key</label>
            <input id="direct-api-key" type="password" autocomplete="off" spellcheck="false" class="mt-2 w-full rounded-xl border border-amber-300 bg-white px-3 py-3 text-sm text-slate-900 outline-none focus:border-violet-500 focus:ring-4 focus:ring-violet-100" placeholder="sk-…" />
            <p class="mt-2 text-xs leading-relaxed text-amber-800">Production test mode calls api.webacela.com directly. This key is kept only in the current browser tab.</p>
          </div>

          <div id="form-error" class="mt-5 hidden rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700" role="alert"></div>

          <button id="submit-button" type="submit" class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-slate-950 px-6 py-4 font-semibold text-white shadow-lg shadow-slate-950/15 transition hover:-translate-y-0.5 hover:bg-violet-700 disabled:cursor-not-allowed disabled:opacity-60 disabled:hover:translate-y-0">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3l1.6 4.4L18 9l-4.4 1.6L12 15l-1.6-4.4L6 9l4.4-1.6L12 3z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15z"/></svg>
            <span id="submit-label">Generate image</span>
          </button>
          <p class="mt-3 text-center text-xs leading-relaxed text-slate-400">AI results can be imperfect. Review images before publishing.</p>
        </form>

        <section class="relative min-h-[34rem] overflow-hidden rounded-3xl border border-slate-200 bg-slate-950 p-4 shadow-xl shadow-slate-900/10 sm:p-6" aria-live="polite">
          <div id="empty-result" class="flex h-full min-h-[30rem] flex-col items-center justify-center rounded-2xl border border-white/10 bg-[radial-gradient(circle_at_top,#312e81_0%,#0f172a_45%,#020617_100%)] px-6 text-center">
            <div class="relative flex h-24 w-24 items-center justify-center rounded-3xl border border-white/10 bg-white/5 text-violet-300 backdrop-blur">
              <div class="absolute inset-0 animate-pulse rounded-3xl bg-violet-500/10"></div>
              <svg class="relative h-11 w-11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="9" cy="9" r="2"/><path d="M21 15l-5-5L5 21"/></svg>
            </div>
            <h2 class="mt-7 text-2xl font-semibold text-white">Your canvas is ready</h2>
            <p class="mt-3 max-w-sm leading-relaxed text-slate-400">Describe an idea or upload an image. Your result will appear here.</p>
          </div>

          <div id="loading-result" class="hidden h-full min-h-[30rem] flex-col items-center justify-center rounded-2xl border border-white/10 bg-slate-900 px-6 text-center">
            <div class="loader-orbit" aria-hidden="true"><span></span><span></span><span></span></div>
            <h2 id="loading-title" class="mt-7 text-2xl font-semibold text-white">Creating your image</h2>
            <p class="mt-3 max-w-sm text-slate-400">This normally takes 15–60 seconds. Please keep this tab open.</p>
          </div>

          <div id="completed-result" class="hidden h-full flex-col">
            <div class="relative flex min-h-[26rem] flex-1 items-center justify-center overflow-hidden rounded-2xl bg-black/30">
              <img id="result-image" class="max-h-[42rem] w-full object-contain" alt="AI-generated result" />
              <span id="result-model" class="absolute left-3 top-3 rounded-full border border-white/10 bg-slate-950/70 px-3 py-1.5 text-xs font-medium text-white backdrop-blur"></span>
            </div>
            <div class="mt-4 grid grid-cols-2 gap-3">
              <button id="try-again" type="button" class="rounded-xl border border-white/15 px-4 py-3 text-sm font-semibold text-white transition hover:bg-white/10">Create variation</button>
              <a id="download-result" class="rounded-xl bg-white px-4 py-3 text-center text-sm font-semibold text-slate-950 transition hover:bg-violet-100" download="webacela-ai-image.png">Download</a>
            </div>
          </div>
        </section>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const modelOptions = {
    generate: [
      ['codex/gpt-5.6-luna', 'Codex Luna · Fast'],
      ['codex/gpt-5.6-sol', 'Codex Sol · Balanced'],
      ['codex/gpt-5.6-terra', 'Codex Terra · Quality'],
    ],
    edit: [
      ['codex/gpt-5.6-luna', 'Codex Luna · Fast'],
      ['codex/gpt-5.6-sol', 'Codex Sol · Balanced'],
      ['codex/gpt-5.6-terra', 'Codex Terra · Quality'],
    ],
  } as const;

  const sizeOptions = {
    generate: [
      ['1024x1024', 'Square · 1024 × 1024'],
      ['1536x1024', 'Landscape · 1536 × 1024'],
      ['1024x1536', 'Portrait · 1024 × 1536'],
    ],
    edit: [
      ['1024x1024', 'Square · 1024 × 1024'],
      ['1536x1024', 'Landscape · 1536 × 1024'],
      ['1024x1536', 'Portrait · 1024 × 1536'],
    ],
  } as const;

  const form = document.querySelector<HTMLFormElement>('#image-tool-form');
  const modeInput = document.querySelector<HTMLInputElement>('#mode');
  const modeButtons = document.querySelectorAll<HTMLButtonElement>('.mode-button');
  const uploadSection = document.querySelector<HTMLElement>('#upload-section');
  const fileInput = document.querySelector<HTMLInputElement>('#source-image');
  const dropZone = document.querySelector<HTMLLabelElement>('#drop-zone');
  const uploadEmpty = document.querySelector<HTMLElement>('#upload-empty');
  const sourcePreview = document.querySelector<HTMLImageElement>('#source-preview');
  const fileRow = document.querySelector<HTMLElement>('#file-row');
  const fileName = document.querySelector<HTMLElement>('#file-name');
  const removeImage = document.querySelector<HTMLButtonElement>('#remove-image');
  const prompt = document.querySelector<HTMLTextAreaElement>('#prompt');
  const promptCount = document.querySelector<HTMLElement>('#prompt-count');
  const modelSelect = document.querySelector<HTMLSelectElement>('#model');
  const sizeSelect = document.querySelector<HTMLSelectElement>('#size');
  const directApiKeySection = document.querySelector<HTMLElement>('#direct-api-key-section');
  const directApiKey = document.querySelector<HTMLInputElement>('#direct-api-key');
  const submitButton = document.querySelector<HTMLButtonElement>('#submit-button');
  const submitLabel = document.querySelector<HTMLElement>('#submit-label');
  const formError = document.querySelector<HTMLElement>('#form-error');
  const emptyResult = document.querySelector<HTMLElement>('#empty-result');
  const loadingResult = document.querySelector<HTMLElement>('#loading-result');
  const loadingTitle = document.querySelector<HTMLElement>('#loading-title');
  const completedResult = document.querySelector<HTMLElement>('#completed-result');
  const resultImage = document.querySelector<HTMLImageElement>('#result-image');
  const resultModel = document.querySelector<HTMLElement>('#result-model');
  const downloadResult = document.querySelector<HTMLAnchorElement>('#download-result');
  const tryAgain = document.querySelector<HTMLButtonElement>('#try-again');

  const MAX_SOURCE_BYTES = 30 * 1024 * 1024;
  const SAFE_UPLOAD_BYTES = 20 * 1024 * 1024;
  const TARGET_UPLOAD_BYTES = Math.floor(19.5 * 1024 * 1024);
  const MAX_IMAGE_DIMENSION = 4096;
  const DIRECT_API_BASE_URL = 'https://api.webacela.com';
  const DIRECT_API_KEY_STORAGE = 'webacela-test-api-key';
  const DEFAULT_DIRECT_API_KEY = import.meta.env.PUBLIC_OMNIROUTER_API_KEY || '';
  const USE_DIRECT_API = import.meta.env.PROD;

  let previewUrl = '';
  let selectedImageFile: File | null = null;
  let fileTaskId = 0;
  let isProcessingFile = false;
  let isSubmitting = false;

  function updateSubmitState() {
    if (submitButton) submitButton.disabled = isProcessingFile || isSubmitting;
  }

  function setOptions(mode: 'generate' | 'edit') {
    if (!modelSelect || !sizeSelect) return;
    modelSelect.innerHTML = modelOptions[mode]
      .map(([value, label]) => `<option value="${value}">${label}</option>`)
      .join('');
    sizeSelect.innerHTML = sizeOptions[mode]
      .map(([value, label]) => `<option value="${value}">${label}</option>`)
      .join('');
  }

  function setMode(mode: 'generate' | 'edit') {
    if (!modeInput || !uploadSection || !submitLabel || !prompt) return;
    modeInput.value = mode;
    uploadSection.classList.toggle('hidden', mode !== 'edit');
    submitLabel.textContent = mode === 'edit' ? 'Transform image' : 'Generate image';
    prompt.placeholder = mode === 'edit'
      ? 'Keep the subject, replace the background with a quiet Japanese garden at sunrise...'
      : 'A cinematic product photo of a translucent glass sneaker on a reflective surface, soft violet lighting...';
    modeButtons.forEach((button) => {
      const active = button.dataset.mode === mode;
      button.setAttribute('aria-pressed', String(active));
    });
    setOptions(mode);
  }

  function showError(message: string) {
    if (!formError) return;
    formError.textContent = message;
    formError.classList.remove('hidden');
  }

  function clearError() {
    formError?.classList.add('hidden');
  }

  function resetFile() {
    fileTaskId += 1;
    selectedImageFile = null;
    isProcessingFile = false;
    updateSubmitState();
    if (fileInput) fileInput.value = '';
    if (previewUrl) URL.revokeObjectURL(previewUrl);
    previewUrl = '';
    sourcePreview?.classList.add('hidden');
    sourcePreview?.removeAttribute('src');
    uploadEmpty?.classList.remove('hidden');
    fileRow?.classList.add('hidden');
    fileRow?.classList.remove('flex');
  }

  function canvasToWebp(canvas: HTMLCanvasElement, quality: number) {
    return new Promise<Blob>((resolve, reject) => {
      canvas.toBlob((blob) => {
        if (blob) resolve(blob);
        else reject(new Error('This browser could not optimize the image.'));
      }, 'image/webp', quality);
    });
  }

  function inferMimeType(base64: string) {
    if (base64.startsWith('iVBOR')) return 'image/png';
    if (base64.startsWith('/9j/')) return 'image/jpeg';
    if (base64.startsWith('UklGR')) return 'image/webp';
    if (base64.startsWith('R0lGOD')) return 'image/gif';
    return 'image/png';
  }

  function normalizeDirectResult(payload: any, model: string) {
    const result = payload?.data?.[0];
    if (!result) throw new Error('OmniRouter returned no image. Please try another model.');

    if (typeof result.b64_json === 'string' && result.b64_json.length > 0) {
      const mimeType = inferMimeType(result.b64_json);
      return {
        image: `data:${mimeType};base64,${result.b64_json}`,
        mimeType,
        model,
      };
    }

    if (typeof result.url === 'string' && result.url.length > 0) {
      return {
        image: result.url,
        mimeType: null,
        model,
      };
    }

    throw new Error('OmniRouter returned an unsupported image format.');
  }

  async function optimizeImage(file: File) {
    if (file.size <= SAFE_UPLOAD_BYTES) return file;

    const bitmap = await createImageBitmap(file);
    const canvas = document.createElement('canvas');
    const context = canvas.getContext('2d');

    if (!context) {
      bitmap.close();
      throw new Error('This browser could not optimize the image.');
    }

    let scale = Math.min(1, MAX_IMAGE_DIMENSION / Math.max(bitmap.width, bitmap.height));
    let quality = 0.88;

    try {
      for (let attempt = 0; attempt < 14; attempt += 1) {
        canvas.width = Math.max(1, Math.round(bitmap.width * scale));
        canvas.height = Math.max(1, Math.round(bitmap.height * scale));
        context.clearRect(0, 0, canvas.width, canvas.height);
        context.drawImage(bitmap, 0, 0, canvas.width, canvas.height);

        const blob = await canvasToWebp(canvas, quality);
        if (blob.size <= TARGET_UPLOAD_BYTES) {
          const baseName = file.name.replace(/\.[^.]+$/, '') || 'source-image';
          return new File([blob], `${baseName}-optimized.webp`, {
            type: 'image/webp',
            lastModified: Date.now(),
          });
        }

        if (quality > 0.58) {
          quality -= 0.1;
        } else {
          scale *= 0.8;
          quality = 0.82;
        }
      }
    } finally {
      bitmap.close();
    }

    throw new Error('The image could not be reduced enough. Try a smaller source image.');
  }

  async function handleFile(file?: File) {
    if (!file) return;
    if (!['image/png', 'image/jpeg', 'image/webp'].includes(file.type)) {
      resetFile();
      showError('Choose a PNG, JPEG, or WebP image.');
      return;
    }
    if (file.size > MAX_SOURCE_BYTES) {
      resetFile();
      showError('The source image must be 30 MB or smaller.');
      return;
    }

    const taskId = ++fileTaskId;
    selectedImageFile = null;
    isProcessingFile = true;
    updateSubmitState();
    clearError();
    fileRow?.classList.remove('hidden');
    fileRow?.classList.add('flex');
    if (fileName) {
      fileName.textContent = file.size > SAFE_UPLOAD_BYTES
        ? `Optimizing ${file.name}…`
        : `${file.name} · ${(file.size / 1024 / 1024).toFixed(1)} MB`;
    }

    try {
      const uploadFile = await optimizeImage(file);
      if (taskId !== fileTaskId) return;

      selectedImageFile = uploadFile;
      if (previewUrl) URL.revokeObjectURL(previewUrl);
      previewUrl = URL.createObjectURL(uploadFile);
      if (sourcePreview) {
        sourcePreview.src = previewUrl;
        sourcePreview.classList.remove('hidden');
      }
      uploadEmpty?.classList.add('hidden');
      if (fileName) {
        const originalSize = (file.size / 1024 / 1024).toFixed(1);
        const uploadSize = (uploadFile.size / 1024 / 1024).toFixed(1);
        fileName.textContent = uploadFile === file
          ? `${file.name} · ${originalSize} MB`
          : `${file.name} · ${originalSize} MB → ${uploadSize} MB`;
      }
    } catch (error) {
      if (taskId !== fileTaskId) return;
      resetFile();
      showError(error instanceof Error ? error.message : 'The image could not be optimized.');
    } finally {
      if (taskId === fileTaskId) {
        isProcessingFile = false;
        updateSubmitState();
      }
    }
  }

  modeButtons.forEach((button) => {
    button.addEventListener('click', () => setMode(button.dataset.mode === 'edit' ? 'edit' : 'generate'));
  });

  prompt?.addEventListener('input', () => {
    if (promptCount) promptCount.textContent = `${prompt.value.length} / 4000`;
  });

  document.querySelectorAll<HTMLButtonElement>('.prompt-chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      if (!prompt) return;
      const addition = chip.textContent?.trim() || '';
      prompt.value = prompt.value.trim() ? `${prompt.value.trim()}, ${addition.toLowerCase()}` : addition;
      prompt.dispatchEvent(new Event('input'));
      prompt.focus();
    });
  });

  fileInput?.addEventListener('change', () => void handleFile(fileInput.files?.[0]));
  removeImage?.addEventListener('click', resetFile);

  ['dragenter', 'dragover'].forEach((eventName) => {
    dropZone?.addEventListener(eventName, (event) => {
      event.preventDefault();
      dropZone.classList.add('border-violet-500', 'bg-violet-50');
    });
  });
  ['dragleave', 'drop'].forEach((eventName) => {
    dropZone?.addEventListener(eventName, (event) => {
      event.preventDefault();
      dropZone.classList.remove('border-violet-500', 'bg-violet-50');
    });
  });
  dropZone?.addEventListener('drop', (event) => {
    const file = event.dataTransfer?.files?.[0];
    if (!file || !fileInput) return;
    const transfer = new DataTransfer();
    transfer.items.add(file);
    fileInput.files = transfer.files;
    void handleFile(file);
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearError();

    if (!prompt?.value.trim()) {
      showError('Describe the image you want to create.');
      prompt?.focus();
      return;
    }
    if (modeInput?.value === 'edit' && !selectedImageFile) {
      showError('Choose a source image to edit.');
      return;
    }
    const browserApiKey = directApiKey?.value.trim() || DEFAULT_DIRECT_API_KEY;
    if (USE_DIRECT_API && !browserApiKey) {
      showError('Enter the testing API key to call api.webacela.com directly.');
      directApiKey?.focus();
      return;
    }

    isSubmitting = true;
    updateSubmitState();
    emptyResult?.classList.add('hidden');
    completedResult?.classList.add('hidden');
    completedResult?.classList.remove('flex');
    loadingResult?.classList.remove('hidden');
    loadingResult?.classList.add('flex');
    if (loadingTitle) loadingTitle.textContent = modeInput?.value === 'edit' ? 'Transforming your image' : 'Creating your image';

    try {
      let response: Response;

      if (USE_DIRECT_API) {
        const headers = { Authorization: `Bearer ${browserApiKey}` };
        if (modeInput?.value === 'edit' && selectedImageFile) {
          const requestData = new FormData();
          requestData.set('model', modelSelect?.value || 'codex/gpt-5.6-luna');
          requestData.set('prompt', prompt?.value.trim() || '');
          requestData.set('size', sizeSelect?.value || '1024x1024');
          requestData.set('n', '1');
          requestData.set('response_format', 'b64_json');
          requestData.set('image', selectedImageFile, selectedImageFile.name);
          response = await fetch(`${DIRECT_API_BASE_URL}/v1/images/edits`, {
            method: 'POST',
            headers,
            body: requestData,
          });
        } else {
          response = await fetch(`${DIRECT_API_BASE_URL}/v1/images/generations`, {
            method: 'POST',
            headers: {
              ...headers,
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              model: modelSelect?.value || 'codex/gpt-5.6-luna',
              prompt: prompt?.value.trim() || '',
              size: sizeSelect?.value || '1024x1024',
              n: 1,
              response_format: 'b64_json',
            }),
          });
        }
      } else {
        const requestData = new FormData(form);
        if (modeInput?.value === 'edit' && selectedImageFile) {
          requestData.set('image', selectedImageFile, selectedImageFile.name);
        }
        response = await fetch('/api/image-tool', {
          method: 'POST',
          body: requestData,
        });
      }

      const payload = await response.json().catch(() => null);
      if (!response.ok) {
        throw new Error(
          payload?.error?.message || payload?.error || payload?.message || 'The image request failed.',
        );
      }
      const output = USE_DIRECT_API
        ? normalizeDirectResult(payload, modelSelect?.value || 'codex/gpt-5.6-luna')
        : payload;

      if (resultImage) resultImage.src = output.image;
      if (resultModel) resultModel.textContent = output.model;
      if (downloadResult) {
        downloadResult.href = output.image;
        downloadResult.download = `webacela-ai-${Date.now()}.${output.mimeType === 'image/webp' ? 'webp' : output.mimeType === 'image/jpeg' ? 'jpg' : 'png'}`;
      }
      loadingResult?.classList.add('hidden');
      loadingResult?.classList.remove('flex');
      completedResult?.classList.remove('hidden');
      completedResult?.classList.add('flex');
    } catch (error) {
      loadingResult?.classList.add('hidden');
      loadingResult?.classList.remove('flex');
      emptyResult?.classList.remove('hidden');
      showError(error instanceof Error ? error.message : 'The image request failed.');
    } finally {
      isSubmitting = false;
      updateSubmitState();
    }
  });

  tryAgain?.addEventListener('click', () => form?.requestSubmit());
  if (USE_DIRECT_API) {
    const sessionApiKey = sessionStorage.getItem(DIRECT_API_KEY_STORAGE) || '';
    if (!DEFAULT_DIRECT_API_KEY) directApiKeySection?.classList.remove('hidden');
    if (directApiKey) directApiKey.value = sessionApiKey;
    directApiKey?.addEventListener('input', () => {
      const value = directApiKey.value.trim();
      if (value) sessionStorage.setItem(DIRECT_API_KEY_STORAGE, value);
      else sessionStorage.removeItem(DIRECT_API_KEY_STORAGE);
    });
  }
  setMode('generate');
</script>

